name: Owned selected folder build only

on:
  create:

permissions:
  contents: read

jobs:
  owned-build-only:
    if: >-
      ${{ github.event_name == 'create' &&
          github.repository == 'krahd/disk_organiser' &&
          github.event.ref_type == 'branch' &&
          github.event.ref == 'validation/owned-build-once-20261012' &&
          github.ref == 'refs/heads/validation/owned-build-once-20261012' }}
    runs-on: macos-15
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        timeout-minutes: 1
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
          set-safe-directory: false
          fetch-depth: 1
          submodules: false
          lfs: false
      - name: One fixed build-only attempt
        id: build
        timeout-minutes: 16
        env:
          EXPECTED_DRIVER_SHA: ${{ github.sha }}
          CREATED_REF: ${{ github.event.ref }}
          CREATED_REF_TYPE: ${{ github.event.ref_type }}
        shell: bash
        run: |
          set -euo pipefail
          checked_out_sha="$(/usr/bin/git rev-parse --verify HEAD)"
          set +e
          terminal="$(/usr/bin/env -i \
            PATH=/usr/bin:/bin:/usr/sbin:/sbin LANG=C LC_ALL=C \
            EXPECTED_DRIVER_SHA="$EXPECTED_DRIVER_SHA" \
            CREATED_REF="$CREATED_REF" CREATED_REF_TYPE="$CREATED_REF_TYPE" \
            GITHUB_EVENT_NAME="$GITHUB_EVENT_NAME" GITHUB_REPOSITORY="$GITHUB_REPOSITORY" \
            GITHUB_REF="$GITHUB_REF" GITHUB_SHA="$GITHUB_SHA" \
            CHECKED_OUT_SHA="$checked_out_sha" GITHUB_WORKFLOW_SHA="$GITHUB_WORKFLOW_SHA" \
            GITHUB_RUN_ATTEMPT="$GITHUB_RUN_ATTEMPT" GITHUB_WORKFLOW_REF="$GITHUB_WORKFLOW_REF" \
            GITHUB_WORKSPACE="$GITHUB_WORKSPACE" GITHUB_RUN_ID="$GITHUB_RUN_ID" \
            ImageOS="$ImageOS" ImageVersion="$ImageVersion" \
            /Users/runner/hostedtoolcache/Python/3.12.10/arm64/bin/python3 -I -S -B native/DiskInventoryCore/Validation/SelectedFolderFeasibility/Tools/stage_b_bootstrap.py 3101dc3f674dc3df015ad73795027d675893208755d07fc213ffd448db980d2a)"
          result=$?
          set -e
          printf '%s\n' "$terminal"
          report_path="$(/usr/bin/env -i \
            PATH=/usr/bin:/bin:/usr/sbin:/sbin LANG=C LC_ALL=C \
            BUILD_TERMINAL="$terminal" GITHUB_RUN_ID="$GITHUB_RUN_ID" GITHUB_SHA="$GITHUB_SHA" \
            /Users/runner/hostedtoolcache/Python/3.12.10/arm64/bin/python3 -I -S -B native/DiskInventoryCore/Validation/SelectedFolderFeasibility/Tools/stage_b_upload.py)"
          printf 'report_path=%s\n' "$report_path" >> "$GITHUB_OUTPUT"
          exit "$result"
      - name: Preserve only the verified data packet
        if: always()
        timeout-minutes: 2
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: owned-selected-folder-build-${{ github.run_id }}
          path: ${{ steps.build.outputs.report_path }}
          if-no-files-found: error
          retention-days: 14
          compression-level: 0
          include-hidden-files: false
